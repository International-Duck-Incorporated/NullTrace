{
	"schemaVersion": 1,
	"id": "nulltrace",
	"version": "${version}",
	"name": "NullTrace",
	"description": "A client-side Fabric privacy mod covering client brand spoofing, fingerprint protection, tracking defenses, and safer server connections.",
	"authors": [
		"International Duck Incorporated",
		"espress0",
		"0xFFshell"
	],
	"contact": {
		"homepage": "https://international-duck-incorporated-github-io-427d19.gitlab.io/nulltrace",
		"sources": "https://gitlab.com/international-duck-incorporated/NullTrace",
		"issues": "https://gitlab.com/international-duck-incorporated/NullTrace/-/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/nulltrace/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.nulltrace.mod.NullTraceClient"
		],
		"modmenu": [
			"net.nulltrace.mod.config.NullTraceModMenuIntegration"
		],
		"mixinsquared": [
			"net.nulltrace.mod.mixin.MeteorMixinCanceller"
		]
	},
	"mixins": [
		{
			"config": "nulltrace.client.mixins.json",
			"environment": "client"
		}
	],
	"conflicts": {
		"exploitpreventer": "*"
	},
	"breaks": {
		"ichor": "*",
		"labymod": "*",
		"autismsexdefender": "*"
	},
	"depends": {
		"fabricloader": ">=0.14.0",
		"minecraft": "${minecraft_version_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
