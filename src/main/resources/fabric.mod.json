{
	"schemaVersion": 1,
	"id": "nulltrace",
	"version": "${version}",
	"name": "NullTrace",
	"description": "Advanced client brand spoofing, tracking exploit protections, and other privacy focused features.",
	"authors": [
		"Aurick"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/nulltrace",
		"sources": "https://github.com/International-Duck-Incorporated/NullTrace",
		"issues": "https://github.com/International-Duck-Incorporated/NullTrace/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/nulltrace/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.nulltrace.mod.NullTraceClient"
		],
		"modmenu": [
			"net.nulltrace.mod.config.NullTraceModMenuIntegration"
		],
		"mixinsquared": [
			"net.nulltrace.mod.mixin.MeteorMixinCanceller"
		]
	},
	"mixins": [
		{
			"config": "nulltrace.client.mixins.json",
			"environment": "client"
		}
	],
	"conflicts": {
		"exploitpreventer": "*"
	},
	"breaks": {
		"ichor": "*",
		"labymod": "*",
		"autismsexdefender": "*"
	},
	"depends": {
		"fabricloader": ">=0.14.0",
		"minecraft": "${minecraft_version_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
