diff --git a/versions/1.21.11/gradle.properties b/versions/1.21.11/gradle.properties
new file mode 100644
index 0000000..f216507
--- /dev/null
+++ b/versions/1.21.11/gradle.properties
@@ -0,0 +1,13 @@
+# Minecraft 1.21.11
+# 1.21.11 renamed ResourceLocation to Identifier
+# 1.21.11 changed CycleButton.builder() API
+# Check versions at https://fabricmc.net/develop
+
+minecraft_version=1.21.11
+loader_version=0.19.3
+fabric_version=0.140.2+1.21.11
+modmenu_version=17.0.0
+
+# Version range this build supports
+minecraft_version_range=>=1.21.11 <26.1
+version_suffix=1.21.11
diff --git a/versions/26.1/gradle.properties b/versions/26.1/gradle.properties
new file mode 100644
index 0000000..f9d35a9
--- /dev/null
+++ b/versions/26.1/gradle.properties
@@ -0,0 +1,13 @@
+# Minecraft 26.1 series (26.1, 26.1.1, 26.1.2)
+# First unobfuscated version line -- uses net.fabricmc.fabric-loom plugin (no remapping)
+# Requires Java 25, Gradle 9.4.0
+# Built against 26.1.2 (newest patch); declared range covers the whole 26.1.x series
+
+minecraft_version=26.1.2
+loader_version=0.19.3
+fabric_version=0.146.1+26.1.2
+modmenu_version=18.0.0-beta.1
+
+# Version range this build supports
+minecraft_version_range=>=26.1 <26.2
+version_suffix=26.1-26.1.2
